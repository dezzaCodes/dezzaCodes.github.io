#!/usr/bin/env python3
"""Suggest colours for flowers whose Colour cell is empty, by having Claude Code look at their photos.

Usage: ./find-colours
Reads the flowers tab, downloads the photo of each row with an empty Colour, asks Claude Code (the `claude`
command, signed in as you) which of the site's colour names fit, prints the answers, and copies a block to the
clipboard for pasting into the Colour column. It never writes to the sheet.

The sheet ID comes from SHEET_ID or the untracked file .sheet_id next to this script. Uses only the Python
standard library, macOS's sips and pbcopy, and Claude Code, so it costs whatever a Claude Code request costs on
the account it is signed into (nothing extra on a Claude subscription).
"""
import csv, glob, io, json, os, re, shutil, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
if not os.environ.get("SHEET_ID"):
    try:
        os.environ["SHEET_ID"] = open(os.path.join(HERE, ".sheet_id")).read().strip()
    except OSError:
        sys.exit("Set SHEET_ID, or put the sheet ID in .sheet_id next to this script.")
sys.path.insert(0, HERE)
import sync  # noqa: E402  (needs SHEET_ID set first)

GID = 0  # the flowers tab
# The colour names the site has swatches for (see SWATCHES in shared/inventory.js).
COLOURS = ["Red", "Pink", "Orange", "Yellow", "Green", "Blue", "Purple", "White", "Cream", "Brown", "Black", "Grey", "Multicolour"]

PROMPT = """Each image file below shows a handmade plush flower from an art installation. The photos may also show other
flowers behind it, hands, stems and leaves, text, or a phone's status bar; ignore those.

For each one, choose the colour names that best describe the flower's head or petals (not its stem or leaves), only from:
{colours}
Give one colour, or two if it is clearly two-toned. Use Multicolour only for three or more prominent colours.
Peach and salmon count as Pink; lavender, violet and plum count as Purple; maroon counts as Red.

{items}

Reply with only a JSON object mapping each row number to a list of colour names, e.g. {{"12": ["Pink"], "13": ["Pink", "White"]}}."""


def claude_binary():
    """The claude command on PATH, else the newest one bundled with the VS Code extension."""
    found = shutil.which("claude")
    if found:
        return found
    bundled = glob.glob(os.path.expanduser("~/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude"))
    if not bundled:
        sys.exit("Can't find Claude Code (the `claude` command).")
    return max(bundled, key=lambda p: [int(x) for x in re.findall(r"\d+", p.split("claude-code-")[1].split("/")[0])])


def main():
    raw, _ = sync.get(sync.SHEET + f"/export?format=csv&gid={GID}")
    rows = list(csv.reader(io.StringIO(raw.decode("utf-8"))))
    header = [h.strip().lower() for h in rows[0]]
    if "colour" not in header:
        sys.exit("The flowers tab has no 'colour' column.")
    ci = header.index("colour")
    col = lambda r, name: r[header.index(name)].strip() if name in header and header.index(name) < len(r) else ""
    # CSV row i is sheet row i + 1 (the header is row 1).
    empty = [i + 1 for i, r in enumerate(rows) if i and any(c.strip() for c in r) and not col(r, "colour")]
    if not empty:
        print("Every flower has a colour.")
        return

    html_view, _ = sync.get(sync.SHEET + f"/htmlview/sheet?headers=true&gid={GID}")
    parser = sync.SheetImages()
    parser.feed(html_view.decode("utf-8", "replace"))

    tmp = tempfile.mkdtemp(prefix="find-colours-")
    items, asked = [], []
    for n in empty:
        r = rows[n - 1]
        label = col(r, "flower") or "(no name)"
        desc = " / ".join(col(r, "description").split("\n"))
        if n not in parser.images:
            print(f"row {n} ({label}): no photo, skipped")
            continue
        data, _ = sync.get(re.sub(r"=[^=/]*$", "", parser.images[n]) + "=w1024")
        src, jpg = os.path.join(tmp, f"{n}.img"), os.path.join(tmp, f"row{n}.jpg")
        open(src, "wb").write(data)
        subprocess.run(["sips", "-s", "format", "jpeg", src, "--out", jpg], check=True, capture_output=True)
        items.append(f"Row {n}: {label}" + (f', described as "{desc}"' if desc else "") + f" - image file {jpg}")
        asked.append(n)
    if not asked:
        return

    print(f"Asking Claude Code about {len(asked)} photo(s)…")
    run = subprocess.run(
        [claude_binary(), "-p", PROMPT.format(colours=", ".join(COLOURS), items="\n".join(items)),
         "--output-format", "json", "--allowedTools", "Read", "--add-dir", tmp],
        capture_output=True, text=True, cwd=tmp)
    shutil.rmtree(tmp, ignore_errors=True)
    if run.returncode:
        sys.exit(f"Claude Code failed:\n{run.stderr or run.stdout}")
    result = json.loads(run.stdout).get("result", "")
    m = re.search(r"\{.*\}", result, re.S)
    if not m:
        sys.exit(f"Couldn't read Claude's answer:\n{result}")
    answers = {int(k): [c for c in v if c in COLOURS][:2] for k, v in json.loads(m.group(0)).items()}

    letter = chr(65 + ci) if ci < 26 else None
    print()
    for n in asked:
        print(f"  row {n:>4}  {(col(rows[n - 1], 'flower') or '(no name)'):<28} {', '.join(answers.get(n, [])) or '?'}")

    # One block covering the first to the last empty row; rows in between keep their current colour.
    first, last = min(asked), max(asked)
    block = [", ".join(answers.get(n, [])) if n in asked else col(rows[n - 1], "colour") for n in range(first, last + 1)]
    subprocess.run(["pbcopy"], input="\n".join(block), text=True)
    target = f"{letter}{first}" if letter else f"row {first} of the Colour column"
    print(f"\nCopied {len(block)} line(s). In the sheet, click {target} and paste."
          + ("" if len(block) == len(asked) else " (Rows in between keep the colours they already have.)"))


if __name__ == "__main__":
    main()
